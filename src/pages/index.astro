---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { classifyTool } from '../lib/classification';
const tools = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name)).map(tool => ({...tool, classification: classifyTool(tool)}));
const categories = [...new Set(tools.map((tool) => tool.data.category))].sort();
const resourceTypes = [...new Set(tools.map((tool) => tool.classification.resourceType))].sort();
const aiRelationships = ['AI-powered', 'AI-integrated', 'AI ecosystem', 'Not AI-specific'];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const categorySymbols = {
  'Agents & Automation': '◈',
  'Developer Tools': '⌘',
  'Data & Documents': '▤',
  'Web & Monitoring': '◎',
  'Media & Creative': '✳',
  'Learning & Research': '◇',
  'Finance': '⌁',
  '3D & Interactive': '⬡',
  'Open Source Apps': '▦',
};
---
<BaseLayout title="AI Tools Catalog — Useful tools, openly collected" description="A free, searchable directory of AI tools and related open-source projects. Community-maintained, without rankings or sponsored placements.">
  <section class="hero container">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-layout">
      <div class="hero-copy">
      <span class="eyebrow"><span class="signal-dot"></span> AN OPEN, COMMUNITY-MAINTAINED DIRECTORY</span>
      <h1>Good tools deserve <span class="gradient-text">to be found.</span></h1>
      <p class="hero-description">A growing collection of AI tools, developer utilities, and projects worth knowing about. Clear descriptions. Useful links. No rankings or hype.</p>
      <div class="hero-actions">
        <a class="primary-button" href="#directory">Explore the catalog <span aria-hidden="true">↘</span></a>
        <a class="secondary-button" href={base + 'contribute/'}>Suggest a tool <span aria-hidden="true">↗</span></a>
      </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-grid"></div>
        <div class="art-orbit art-orbit-outer"></div>
        <div class="art-orbit art-orbit-inner"></div>
        <div class="art-core"><span class="art-core-mark">✳</span><span>EXPLORE THE POSSIBILITIES</span></div>
        <div class="art-node art-node-one"><span>◈</span> Agents & automation</div>
        <div class="art-node art-node-two"><span>⌘</span> Developer tools</div>
        <div class="art-node art-node-three"><span>▤</span> Data & documents</div>
        <div class="art-node art-node-four"><span>✳</span> Media & creative</div>
        <span class="art-star art-star-one">✧</span><span class="art-star art-star-two">✧</span>
      </div>
    </div>
    <div class="hero-stats" aria-label="Catalog statistics">
      <div><strong>{tools.length}</strong><span>collected tools</span></div>
      <div class="stat-separator"></div>
      <div><strong>{categories.length}</strong><span>categories</span></div>
      <div class="stat-separator"></div>
      <div><strong>100%</strong><span>public & open</span></div>
    </div>
  </section>

  <section class="prompt-promo container" aria-label="Prompts and workflows">
    <div class="prompt-promo-icon" aria-hidden="true">⌘</div>
    <div>
      <span class="overline">NEW COLLECTION</span>
      <h2>Prompts &amp; workflows</h2>
      <p>Reusable motion design prompts and practical video-production recipes. Separate from software listings.</p>
    </div>
    <a class="secondary-button" href={base + 'prompts/'}>Browse prompts ↗</a>
  </section>

  <section class="catalog-section container" id="directory" aria-label="Tool directory">
    <div class="section-heading">
      <div><div class="overline">THE DIRECTORY</div><h2>Explore the collection</h2><p>Filter by resource type, AI relationship, or area of use; search by name, description, or tag.</p></div>
      <a href={base + 'contribute/'} class="text-action">Missing something? Contribute <span aria-hidden="true">↗</span></a>
    </div>

    <div class="filter-panel">
      <div class="search-box">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7.2"/><path d="m16.3 16.3 4.5 4.5"/></svg>
        <label class="sr-only" for="tool-search">Search the catalog</label>
        <input id="tool-search" type="search" placeholder="Search tools, use cases, tags..." autocomplete="off" aria-controls="tools-grid" aria-describedby="search-help"/>
        <button id="clear-search" class="clear-search" type="button" aria-label="Clear search" hidden>×</button>
        <kbd class="search-hint" aria-hidden="true">/</kbd>
      </div>
      <p class="sr-only" id="search-help">Press slash to search, or Escape to clear the search.</p>
      <div class="taxonomy-filters">
        <label for="resource-type-filter">Resource type
          <select id="resource-type-filter" aria-controls="tools-grid">
            <option value="all">All resource types</option>
            {resourceTypes.map(type => <option value={type}>{type}</option>)}
          </select>
        </label>
        <label for="ai-relationship-filter">Relationship with AI
          <select id="ai-relationship-filter" aria-controls="tools-grid">
            <option value="all">Any AI relationship</option>
            {aiRelationships.map(role => <option value={role}>{role}</option>)}
          </select>
        </label>
      </div>
      <div class="category-filters" role="group" aria-label="Filter by area of use">
        <button class="filter-chip active" type="button" data-filter="all" aria-controls="tools-grid" aria-pressed="true">All tools <span>{tools.length}</span></button>
        {categories.map((category) => (
          <button class="filter-chip" type="button" data-filter={category} aria-controls="tools-grid" aria-pressed="false">{category} <span>{tools.filter((tool) => tool.data.category === category).length}</span></button>
        ))}
      </div>
    </div>

    <div class="directory-meta">
      <p id="results-count" aria-live="polite">Showing {tools.length} tools</p>
      <span>Alphabetical · No paid placements</span>
    </div>

    <div class="tools-grid" id="tools-grid">
      {tools.map((tool) => (
        <article class="tool-card" data-category={tool.data.category} data-resource-type={tool.classification.resourceType} data-ai-relationship={tool.classification.aiRelationship} data-search={[tool.data.name,tool.data.summary,tool.classification.resourceType,tool.classification.aiRelationship,tool.data.category,...tool.data.tags].join(' ').toLowerCase()}>
          <div class="card-top">
            <div class="tool-icon" aria-hidden="true">{categorySymbols[tool.data.category]}</div>
            <span class="card-category" title={tool.data.category}>{tool.classification.resourceType} · {tool.classification.aiRelationship}</span>
            <a class="card-external" href={tool.data.url} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + tool.data.name + ' official link'}>↗</a>
          </div>
          <a class="tool-name" style={'view-transition-name: tool-' + tool.id} href={base + 'tools/' + tool.id + '/'}>{tool.data.name}</a>
          <p class="tool-summary">{tool.data.summary}</p>
          <div class="card-bottom"><div class="tag-list">{tool.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div><a class="card-more" href={base + 'tools/' + tool.id + '/'} aria-label={'Read details about ' + tool.data.name}>Details →</a></div>
        </article>
      ))}
    </div>
    <div class="empty-state" id="empty-state" hidden><div class="empty-symbol">⌕</div><h3>No tools found</h3><p>Try different search terms or choose another category.</p><button id="reset-filters" class="secondary-button" type="button">Clear filters</button></div>
  </section>

  <section class="contribution-banner container">
    <div><span class="overline">OPEN SOURCE, OPEN TO IDEAS</span><h2>Found something useful?</h2><p>Share it with the community. Suggest a tool, correct a description, or improve the website through GitHub.</p></div>
    <a class="primary-button" href={base + 'contribute/'}>How to contribute <span aria-hidden="true">↗</span></a>
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#tool-search');
    const cards = [...document.querySelectorAll<HTMLElement>('.tool-card')];
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('.category-filters .filter-chip')];
    const typeFilter = document.querySelector<HTMLSelectElement>('#resource-type-filter');
    const relationshipFilter = document.querySelector<HTMLSelectElement>('#ai-relationship-filter');
    const count = document.querySelector<HTMLElement>('#results-count');
    const empty = document.querySelector<HTMLElement>('#empty-state');
    const reset = document.querySelector<HTMLButtonElement>('#reset-filters');
    const clear = document.querySelector<HTMLButtonElement>('#clear-search');
    const grid = document.querySelector<HTMLElement>('#tools-grid');
    const normalize = (value: string) =>
      value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const searchableCards = cards.map((card) => ({
      element: card,
      text: normalize(card.dataset.search || ''),
    }));
    let selectedCategory = 'all';

    function updateUrl(mode: 'push' | 'replace') {
      const url = new URL(window.location.href);
      const query = searchInput?.value.trim() || '';
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (selectedCategory !== 'all') url.searchParams.set('category', selectedCategory);
      else url.searchParams.delete('category');
      if (typeFilter?.value && typeFilter.value !== 'all') url.searchParams.set('type', typeFilter.value);
      else url.searchParams.delete('type');
      if (relationshipFilter?.value && relationshipFilter.value !== 'all') url.searchParams.set('ai', relationshipFilter.value);
      else url.searchParams.delete('ai');
      if (url.href !== window.location.href) {
        if (mode === 'push') history.pushState(null, '', url);
        else history.replaceState(null, '', url);
      }
    }

    function applyFilters() {
      const query = normalize((searchInput?.value || '').trim());
      let visible = 0;
      for (const { element, text } of searchableCards) {
        const matchesCategory = selectedCategory === 'all' || element.dataset.category === selectedCategory;
        const matchesType = !typeFilter || typeFilter.value === 'all' || element.dataset.resourceType === typeFilter.value;
        const matchesAi = !relationshipFilter || relationshipFilter.value === 'all' || element.dataset.aiRelationship === relationshipFilter.value;
        const matches = matchesCategory && matchesType && matchesAi && (!query || text.includes(query));
        element.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = 'Showing ' + visible + ' of ' + cards.length + ' tools';
      if (empty) empty.hidden = visible !== 0;
      if (clear) clear.hidden = !searchInput?.value;
    }

    function setCategory(category: string, save = true) {
      const valid = category === 'all' || filterButtons.some((button) => button.dataset.filter === category);
      const next = valid ? category : 'all';
      const changed = selectedCategory !== next;
      selectedCategory = next;
      for (const button of filterButtons) {
        const active = button.dataset.filter === selectedCategory;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      }
      applyFilters();
      if (save && changed) updateUrl('push');
    }

    function restoreFromUrl() {
      const params = new URLSearchParams(window.location.search);
      if (searchInput) searchInput.value = params.get('q') || '';
      if (typeFilter) {
        const type = params.get('type') || 'all';
        typeFilter.value = [...typeFilter.options].some(option => option.value === type) ? type : 'all';
      }
      if (relationshipFilter) {
        const role = params.get('ai') || 'all';
        relationshipFilter.value = [...relationshipFilter.options].some(option => option.value === role) ? role : 'all';
      }
      setCategory(params.get('category') || 'all', false);
    }

    function clearSearch() {
      if (!searchInput) return;
      searchInput.value = '';
      applyFilters();
      updateUrl('replace');
      searchInput.focus();
    }

    searchInput?.addEventListener('input', () => {
      applyFilters();
      updateUrl('replace');
    });
    clear?.addEventListener('click', clearSearch);
    filterButtons.forEach((button) =>
      button.addEventListener('click', () => setCategory(button.dataset.filter || 'all'))
    );
    for (const selector of [typeFilter, relationshipFilter]) {
      selector?.addEventListener('change', () => { applyFilters(); updateUrl('push'); });
    }
    reset?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (typeFilter) typeFilter.value = 'all';
      if (relationshipFilter) relationshipFilter.value = 'all';
      setCategory('all');
      applyFilters();
      updateUrl('replace');
      searchInput?.focus();
    });
    document.addEventListener('keydown', (event) => {
      const target = event.target;
      const editing = target instanceof Element && !!target.closest('input, textarea, select, [contenteditable]');
      if (event.key === '/' && !editing && !event.altKey && !event.ctrlKey && !event.metaKey) {
        event.preventDefault();
        searchInput?.focus();
      } else if (event.key === 'Escape' && document.activeElement === searchInput) {
        event.preventDefault();
        if (searchInput?.value) clearSearch();
        else searchInput?.blur();
      }
    });
    window.addEventListener('popstate', restoreFromUrl);

    if (grid && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      grid.addEventListener('pointermove', (event) => {
        if (!(event.target instanceof Element)) return;
        const card = event.target.closest<HTMLElement>('.tool-card');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--pointer-x', event.clientX - rect.left + 'px');
        card.style.setProperty('--pointer-y', event.clientY - rect.top + 'px');
      });
    }

    restoreFromUrl();
  </script>
</BaseLayout>
