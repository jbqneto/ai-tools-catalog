---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('prompts');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<BaseLayout title={item.data.title + ' — Prompts & Workflows'} description={item.data.summary}>
  <section class="prompt-detail container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={base}>Directory</a><span>/</span><a href={base + 'prompts/'}>Prompts &amp; Workflows</a><span>/</span><span aria-current="page">{item.data.title}</span></nav>
    <div class="prompt-detail-heading">
      <span class="eyebrow">{item.data.kind === 'prompt' ? 'COPY-READY PROMPT' : 'VIDEO WORKFLOW GUIDE'}</span>
      <h1>{item.data.title}</h1>
      <p>{item.data.summary}</p>
      <div class="detail-tags">{item.data.tags.map(tag => <span class="tag">{tag}</span>)}</div>
    </div>
    <div class="detail-layout">
      <article class="detail-article prompt-prose">
        <Content />
        <div class="profile-disclaimer">This is an independently written reference, not an endorsement or a guarantee of specific output quality. Review generated code, third-party permissions, licensing, and exports before publishing.</div>
      </article>
      <aside class="detail-sidebar" aria-label="Reference information">
        <h2>Reference details</h2>
        <div class="sidebar-item"><span>Type</span><strong>{item.data.kind === 'prompt' ? 'Prompt template' : 'Workflow concept'}</strong></div>
        <div class="sidebar-item"><span>Category</span><strong>{item.data.category}</strong></div>
        {item.data.sourceNote && <div class="sidebar-item"><span>Source context</span><strong>{item.data.sourceNote}</strong></div>}
        {item.data.relatedUrl && <div class="sidebar-links"><a href={item.data.relatedUrl} target="_blank" rel="noopener noreferrer">Related project ↗</a></div>}
        <a class="suggest-correction" href={'https://github.com/jbqneto/ai-tools-catalog/issues/new?template=correction.yml&title=' + encodeURIComponent('Correction: ' + item.data.title)}>Suggest a correction ↗</a>
      </aside>
    </div>
    <a class="back-link" href={base + 'prompts/'}>← Back to prompts &amp; workflows</a>
  </section>
  <script>
    document.querySelectorAll<HTMLElement>('.prompt-prose pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const copy = document.createElement('button');
      copy.className = 'prompt-copy';
      copy.type = 'button';
      copy.textContent = 'Copy prompt';
      copy.setAttribute('aria-label', 'Copy this prompt to clipboard');
      pre.before(copy);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          copy.textContent = 'Copied ✓';
          copy.setAttribute('aria-label', 'Prompt copied');
        } catch {
          copy.textContent = 'Select code to copy';
          copy.setAttribute('aria-label', 'Select the code below to copy manually');
        }
      });
    });
  </script>
</BaseLayout>
