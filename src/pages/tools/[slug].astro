---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { classifyTool } from '../../lib/classification';
export async function getStaticPaths() {
  const entries = await getCollection('tools');
  return entries.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}
const { tool } = Astro.props;
const classification = classifyTool(tool);
const { Content } = await render(tool);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<BaseLayout title={tool.data.name + ' — AI Tools Catalog'} description={tool.data.summary}>
  <section class="detail-page container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={base}>Directory</a><span>/</span><span>{tool.data.category}</span><span>/</span><span aria-current="page">{tool.data.name}</span></nav>
    <div class="detail-heading">
      <div><span class="overline">CATALOG PROFILE · {classification.resourceType}</span><h1 style={'view-transition-name: tool-' + tool.id}>{tool.data.name}</h1><p class="detail-summary">{tool.data.summary}</p><div class="detail-tags">{tool.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div>
      <a class="primary-button" href={tool.data.url} target="_blank" rel="noopener noreferrer">Visit official link ↗</a>
    </div>
    <div class="detail-layout">
      <article class="detail-article"><h2>About this tool</h2><div class="prose"><Content /></div><div class="profile-disclaimer">This profile is a curated reference, not an endorsement. Verify capabilities, licensing, and security information with the project maintainers before use.</div></article>
      <aside class="detail-sidebar" aria-label="Project links and metadata">
        <h2>At a glance</h2>
        <div class="sidebar-item"><span>Resource type</span><strong>{classification.resourceType}</strong></div>
        <div class="sidebar-item"><span>AI relationship</span><strong>{classification.aiRelationship}</strong></div>
        <div class="sidebar-item"><span>Area of use</span><strong>{tool.data.category}</strong></div>
        <div class="sidebar-item"><span>Link status</span><strong class={tool.data.verification === 'confirmed' ? 'status-confirmed' : 'status-unverified'}>{tool.data.verification === 'confirmed' ? 'Repository / project identified' : 'Identity needs verification'}</strong></div>
        <div class="sidebar-links"><a href={tool.data.url} target="_blank" rel="noopener noreferrer">Official project ↗</a>{tool.data.repository && tool.data.repository !== tool.data.url && <a href={tool.data.repository} target="_blank" rel="noopener noreferrer">Source repository ↗</a>}</div>
        <a class="suggest-correction" href={'https://github.com/jbqneto/ai-tools-catalog/issues/new?template=correction.yml&title=' + encodeURIComponent('Correction: ' + tool.data.name)}>Suggest a correction ↗</a>
      </aside>
    </div>
    <a class="back-link" href={base}>← Back to all tools</a>
  </section>
</BaseLayout>
